{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/hook_launcher.py\" \"${PLUGIN_ROOT}\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\hook_launcher.py\" \"%PLUGIN_ROOT%\"",
            "timeout": 10,
            "statusMessage": "Selecting the appropriate GPT-6 route"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/hook_launcher.py\" \"${PLUGIN_ROOT}\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\hook_launcher.py\" \"%PLUGIN_ROOT%\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/hook_launcher.py\" \"${PLUGIN_ROOT}\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\hook_launcher.py\" \"%PLUGIN_ROOT%\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/hook_launcher.py\" \"${PLUGIN_ROOT}\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\hook_launcher.py\" \"%PLUGIN_ROOT%\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/hook_launcher.py\" \"${PLUGIN_ROOT}\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\hook_launcher.py\" \"%PLUGIN_ROOT%\"",
            "timeout": 10,
            "statusMessage": "Checking routing and verification evidence"
          }
        ]
      }
    ]
  }
}
